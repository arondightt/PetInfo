# Configurações do Ambiente
# development = erros detalhados aparecem | production = oculta erros (segurança)
APP_ENV=development

# URL do seu Front-end (ex: https://meusite.vercel.app)
# Usado para configurar o CORS e permitir que apenas seu front faça requisições
FRONT_URL=http://localhost:3000

# ==========================================
# Banco de Dados (Supabase / PostgreSQL)
# ==========================================
# Insira os dados fornecidos pelo painel do Supabase
DB_HOST=aws-0-sa-east-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.xxxxxxxxxx
DB_PASS=xxxxxxxxxx
# require garante que a conexão com a nuvem seja encriptada (seguro)
DB_SSL=require

# ==========================================
# Autenticação JWT (Tokens)
# ==========================================
# Chave secreta super segura (Gere uma chave longa aleatória em produção)
JWT_SECRET=super_secret_key_change_me_in_production
# Tempo de expiração em segundos (604800 = 7 dias)
JWT_EXPIRY=604800
