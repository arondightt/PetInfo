{
    "name": "pettag/api",
    "description": "API back-end da plataforma PetTag — PHP 8.2 + Slim 4",
    "license": "AGPL-3.0-only",
    "require": {
        "php": "8.4.0",
        "slim/slim": "4.12.0",
        "slim/psr7": "1.6.0",
        "firebase/php-jwt": "6.10.0",
        "vlucas/phpdotenv": "5.6.0"
    },
    "require-dev": {
        "phpunit/phpunit": "11.0.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
