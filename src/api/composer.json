{
    "name": "pettag/api",
    "description": "API back-end da plataforma PetTag — PHP 8.2 + Slim 4",
    "license": "AGPL-3.0-only",
    "require": {
        "php": "8.4.0",
        "slim/slim": "4.15.2",
        "slim/psr7": "1.8.0",
        "firebase/php-jwt": "6.11.1",
        "vlucas/phpdotenv": "5.6.4"
    },
    "require-dev": {
        "phpunit/phpunit": "11.5.56"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
